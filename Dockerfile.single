# One image for the temporary Render prototype. The two pinned submodules are
# included in this repository's build context by Render's Git checkout.
FROM node:22-bookworm-slim AS web-build
WORKDIR /workspace/web
COPY bundle/frontend/package.json bundle/frontend/package-lock.json ./
RUN npm ci
COPY bundle/frontend/ ./
ARG BACKEND_INTERNAL_URL=http://127.0.0.1:8001
ARG NEXT_PUBLIC_USE_SAME_ORIGIN_API=true
ENV BACKEND_INTERNAL_URL=${BACKEND_INTERNAL_URL} \
    NEXT_PUBLIC_USE_SAME_ORIGIN_API=${NEXT_PUBLIC_USE_SAME_ORIGIN_API}
RUN npm run build

FROM python:3.12-slim-bookworm AS python-build
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv

WORKDIR /workspace/agent
COPY pyproject.toml uv.lock README.md ./
COPY app agent mcp_client mcp_server schemas services config docs ./
RUN uv sync --locked --no-dev

WORKDIR /workspace/gateway
COPY bundle/gateway/ ./
RUN uv sync --locked --no-dev

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=web-build /workspace/web /workspace/web
COPY --from=python-build /workspace/agent /workspace/agent
COPY --from=python-build /workspace/gateway /workspace/gateway
COPY scripts/single_container.py /opt/wayfind/single_container.py
RUN node --version \
    && cd /workspace/agent \
    && /workspace/agent/.venv/bin/python -c "import app.main, mcp_server.server" \
    && cd /workspace/gateway \
    && /workspace/gateway/.venv/bin/python -c "import app.main, db.migrate"

EXPOSE 10000
CMD ["python", "/opt/wayfind/single_container.py"]
