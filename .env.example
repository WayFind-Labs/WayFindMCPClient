# ── NOTE: This service is INTERNAL only ─────────────────────────────────────
# It is NOT exposed to the browser. ShelterAppUiBackend (port 8001) is the
# public-facing API. This service runs on port 8000 (internal / Docker network).
#
# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: groq | gemini | openai
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Downstream Service URLs ───────────────────────────────────────────────────
POSTGRES_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
IMAGE_BACKEND_URL=http://localhost:8003
SUPPORT_SERVICE_URL=http://localhost:8004
REVIEW_SERVICE_URL=http://localhost:8005

# ── Media Safety Scan ─────────────────────────────────────────────────────────
MEDIA_SAFETY_SCAN_URL=http://localhost:8006

# ── Session Backend ───────────────────────────────────────────────────────────
# Options: memory | redis
SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# ── Candidate Pool Limits ─────────────────────────────────────────────────────
MAX_CANDIDATE_POOL=50
MAX_IMAGE_CANDIDATES=20

# ── Internal Auth ────────────────────────────────────────────────────────────
# Shared secret between this service and ShelterAppUiBackend.
# All requests must carry: X-Internal-Key: <value>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SHELTER_BACKEND_API_KEY=changeme-dev-secret

# ── Internal Server ───────────────────────────────────────────────────────────
INTERNAL_HOST=0.0.0.0
INTERNAL_PORT=8000

# ── MCP Transport ─────────────────────────────────────────────────────────────
# Options: sse | stdio
MCP_TRANSPORT=sse
MCP_SERVER_URL=http://localhost:9000/sse
