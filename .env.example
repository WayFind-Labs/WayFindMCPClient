# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=

# ── Downstream Service URLs ───────────────────────────────────────────────────
POSTGRES_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
IMAGE_BACKEND_URL=http://localhost:8003
SUPPORT_SERVICE_URL=http://localhost:8004
REVIEW_SERVICE_URL=http://localhost:8005

# ── Media Safety Scan ─────────────────────────────────────────────────────────
MEDIA_SAFETY_SCAN_URL=http://localhost:8006

# ── Session Backend ───────────────────────────────────────────────────────────
# Options: memory | redis
SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# ── Candidate Pool Limits ─────────────────────────────────────────────────────
MAX_CANDIDATE_POOL=50
MAX_IMAGE_CANDIDATES=20

# ── API Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── MCP Transport ─────────────────────────────────────────────────────────────
# Options: sse | stdio
MCP_TRANSPORT=sse
MCP_SERVER_URL=http://localhost:9000/sse
